# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=

# Backend API URL. For docker compose overlay use http://api:8000
BOT_API_BASE_URL=http://localhost:8000

# Public URL used in QR/link messages. Examples:
#   http://localhost:8000
#   https://vpn.example.com/api
#   https://api.example.com
BOT_PUBLIC_SUB_BASE_URL=http://localhost:8000

# Existing backend admin credentials.
# The bot uses only the public HTTP API and does not import backend code.
BOT_ADMIN_USERNAME=admin
BOT_ADMIN_PASSWORD=admin

# Optional tuning
BOT_REQUEST_TIMEOUT_SECONDS=30
BOT_TRAFFIC_REFRESH=true
